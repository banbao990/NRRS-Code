flat Vector2f;
flat Vector3f;
flat Spectrum;
flat int;
flat BSDFType;
flat float;
flat uint;
flat Light;

struct Ray;
struct LightSampleContext;
struct SurfaceInteraction;
flat PCGSampler;

struct EARSInferenceItem {
	uint mTid;
	Vector3f mPos;
	Vector3f mDir;
	float mRoughness;
};

struct EARSRadianceRecordItem {
	Spectrum mL;
	Spectrum mThp;
	Vector3f mPos;
	Vector3f mDir;
	int mLastNodeIdx;
	uint mCost;
	float mRoughness;
};

struct EARSRayWorkItem {
	Ray mRay;
	LightSampleContext mCtx;
	float mPdf;
	Spectrum mThp;
	BSDFType mBsdfType;
	uint mDepth;
	uint mPixelId;
	int mNodeIdx;
};

struct EARSHitLightWorkItem {
	Light mLight;
	LightSampleContext mCtx;
	float mPdf;
	Vector3f mPos;
	Vector3f mWo;
	Vector3f mNormal;
	Vector2f mUv;
	Spectrum mThp;
	BSDFType mBsdfType;
	uint mDepth;
	uint mPixelId;
	int mNodeIdx;
};

struct EARSShadowRayWorkItem {
	Ray mRay;
	float mMaxT;
	Spectrum mLi;
	Spectrum mThp;
	uint mDepth;
	uint mPixelId;
	int mNodeIdx;
};

struct EARSScatterRayWorkItem {
	Spectrum mThp;
	int mNodeIdx;
	SurfaceInteraction mIntr;
	uint mDepth;
	uint mPixelId;
};

struct EARSPixelState {
	Spectrum mL;
	float mDepth;
	float mDiff2;
	PCGSampler mSampler;
};