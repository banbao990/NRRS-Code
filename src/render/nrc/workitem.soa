flat int;
flat uint;
flat float;
flat bool;
flat double;
flat Light;
flat BSDFType;
flat LCGSampler;
flat PCGSampler;
flat HaltonSampler;

flat Vector2f;
flat Vector3f;
flat Spectrum;
flat RGB;

struct SurfaceInteraction;
struct LightSampleContext;
struct Ray;

struct NRCHitLightWorkItem {
	Light mLight;
	LightSampleContext mCtx;
	float mPdf;
	Vector3f mPos;
	Vector3f mWo;
	Vector3f mNormal;
	Vector2f mUv;
	Spectrum mThp;
	BSDFType mBsdfType;
	uint mDepth;
	uint mPixelId;
	float mA0;
	float mAn;
};

struct NRCRayWorkItem {
	Ray mRay;
	LightSampleContext mCtx;
	float mPdf;
	Spectrum mThp;
	BSDFType mBsdfType;
	uint mDepth;
	uint mPixelId;
	float mA0;
	float mAn;
};

struct NRCScatterRayWorkItem {
	Spectrum mThp;
	SurfaceInteraction mIntr;
	uint mDepth;
	uint mPixelId;
	float mA0;
	float mAn;
	float mAnEle;
};

struct NRCRadianceRecordItem {
	RGB mL;
	RGB mThp;
	Vector3f mPos;
	Vector2f mDir;
	bool mDelta;
	Vector2f mNormal;
	float mRoughness;
};

struct NRCInferenceWorkItem {
	uint mPixelId;
	RGB mThp;
	Vector3f mPos;
	Vector3f mDir;
	float mA0;
	float mDepth;
	Vector2f mNormal;
	float mRoughness;
};

struct NRCPathPixelState {
	NRCRadianceRecordItem mRecords[NRC_MAX_TRAIN_DEPTH];
	uint mCurDepth;
};