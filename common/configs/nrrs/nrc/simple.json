{
    "nn": {
        "loss": {
            "otype": "RelativeL2Luminance"
            //"otype": "RelativeL2"
            //"otype": "L2"
        },
        "optimizer": {
            "otype": "Ema",
            "decay": 0.95,
            "nested": {
                "otype": "Adam",
                "learning_rate": 8e-3,
                "beta1": 0.9,
                "beta2": 0.99,
                "epsilon": 1e-15,
                "l2_reg": 3e-6,
                "adabound": false
            }
        },
        "encoding": {
            // simple input: pos(3) + dir(2)
            "otype": "Composite",
            "nested": [
                {
                    "n_dims_to_encode": 3, // Spatial dims

                    // "otype": "TriangleWave",
                    // "n_frequencies": 12

                    "otype": "HashGrid",
                    "n_levels": 16,
                    "n_features_per_level": 2,
                    "log2_hashmap_size": 19,
                    "base_resolution": 16,
                    "per_level_scale": 2.0
                },
                {
                    "n_dims_to_encode": 2, // Directional dims
                    "otype": "OneBlob",
                    "n_bins": 4
                }
            ]
        },
        "network": {
            "otype": "FullyFusedMLP",
            "activation": "ReLU",
            "output_activation": "None",
            "n_neurons": 32, // 64
            "n_hidden_layers": 3 // 7 in paper
        }
    }
}
