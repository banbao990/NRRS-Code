{
    "renderer": {
        //"save_frames": true,
        //"save_frame_interval": 1,
        "ui_alpha_off": true,
        "lock_camera": true
    },

    "global": {
        // run_experiment
        "exp_train_time": 60,
        "exp_inference_time": 10,
        //"exp_on": true,
        "exp_output_file": "common/exps/result.exr"
    },

    "passes": [
        {
            "enable": true,

            //"name": "EARSPathTracer",
            //"name": "ADNPathTracer",
            "name": "NRRSPathTracer",

            //"name": "NRCPathTracer",

            //"name": "SimpleWavefrontPathTracer", // PT baseline

            "params": {
                // nrc+adn
                "config": "common/configs/nrrs/nrc/simple.json",
                //"config": "common/configs/nrrs/nrc/auxiliary.json",

                // nrrs
                "nrrs_config": "common/configs/nrrs/nrrs/2net-simple.json",
                //"nrrs_config": "common/configs/nrrs/nrrs/2net-simple-test.json",
                "nrrs_auto_train": true, // 10,10,30
                "nrrs_auto_train_state0_time": 0,
                "nrrs_auto_train_state1_time": 10,
                "nrrs_auto_train_state2_time": 0,
                "nrrs_auto_train_state3_time": 300000,

                "nee": true,
                "rr": 1.0,
                "max_depth": 6,

                // ADRRS/EARS

                //"rrs_method": "adrrs",
                "rrs_method": "ears",
                //"rrs_method": "adrrsn",
                //"rrs_method": "earsn",
                //"rrs_method": "earst", // nn cache + tree cache
                //"rrs_method": "nrrs+",
                //"rrs_method": "nrrs",
                //"rrs_method": "adn", 

                // NRRS
                //"net1_aid_net2": true, // default false. true: net1 is only for training, not for inference
                // "ll2_use_two_head": true, // default false
                "ll2_two_head_type": 1, // dafault 1 (PartShare); (2: JustEncoding, 3: AllSelf, see 'src/render/nrrs/net/myNetworkLL2.h:L9' LL2TwoHeadType)

                "rrs_clamp_min": 0.05,
                "rrs_clamp_max": 20.0,
                "rrs_normalize_rate": 0.85,
                "rrs_normalize_use_ceil": true, // true: do not use rrs_normalize_rate, false: use rrs_normalize_rate
                "donnot_normalize_when_less_than_one": true, // to support deeper depth
                "use_acc_buffer_not_denoised_nrrs": true,
                "use_acc_buffer_not_denoised_ears": true,

                "ubs_heuristic": false,
                "ubs_heuristic_mix_method": 2,

                "rrs_mode": "fixed RR",
                "use_max_queue_size": true, /* may slower */
                "spp": 1,
                "max_rate_for_path_nodes_buffer": 10,
                "blend_weight_for_error": 0.5,
                //"max_depth_to_use_rrs_included": 0,
                "max_depth_to_use_rrs_included": 10,
                "copy_the_rrs_node": true,
                "ignore_same_training_data_for_rrs_net": true,
                //"stop_training": true,

                // debug
                "show_net_debug_type_is_float": true, // ture: float, false: uint32_t

                "batch_per_frame": 20,

                // ADN+EARS
                // C-RRS
                "as_clamp_on": true,
                "as_clamp_max": 8,
                "as_use_efficiency_metric": false,
                "as_use_relative_metric": false,

                // EARS
                "spp_per_iter": 64,
                "enable_rrs_after_pre_training": true,
                "auto_build_octree": true,
                "outlier_number": 10000, // 0.001% x 1280 x 720 = 9.216, 10 in original impl, however bad
                "pre_training_iter": 3, // bathroom=3
                "twice_iter_interval": 1,
                "octree_max_memory": 24,
                "keep_last_iter_statistics": true, // incremental training

                // NRRS
                "nrrs_denoise_dont_need_albedo": true, // NRRS is true, as it denoise error
                "error_image_scale": 1,
                "denoise_on": true,
                "denoise_frames": -1, // only denoise first xxx frames, denoise all frames if set to -1
                "denoise_params": {
                    "enable": true,
                    "denoisepass_params": {
                        "prepareGeometryBufferOutside": true,
                        "useGeometry": true
                    }
                },

                // ADRRS/PPG
                "spp_per_pass": 4,
                "max_memory": 16,
                "distribution": "radiance", // ADRRS must be radiance
                "spatial_filter": "nearest",
                "directional_filter": "nearest",
                "stree_thres": 2000,
                "dtree_thres": 0.005,
                "auto_build": false
            }
        },

        {
            "enable": false,
            "name": "AccumulatePass",
            "params": {
                "precision": "double",

                "spp": 100,
                "time": 0,
                "mode": "accumulate time"

                // render reference image
                //"save_every": 5000,
                //"exit_on_finish": true,
                //"task": {
                //    "type": "spp",
                //    "value": 200000
                //}

            }
        },

        //{
        //    "enable": true,
        //    "name": "DenoisePass"
        //},

        //{
        //    "enable": false,
        //    "name": "LoadImagePass",
        //    "params": {
        //        "image_path": ""
        //    }
        //},

        {
            "enable": true,
            "name": "ErrorMeasurePass",
            "params": {
                //"showReferenceImage": true,
                "metric": "rel_mse",
                "interval": 10,
                "continuous": true,
                "log": false,
                "vJetMax": 0.01,
                //"exp_save": true,
                "vJetMaxAdjusted": 5.0
            }
        },

        {
            "enable": true,
            "name": "ToneMappingPass",
            "params": {
                "exposure": 1,
                "gamma": true,
                //"operator": "aces",
                //"operator": "linear"
                "operator": "lin2srgb"
                //"operator": "jet",
                //"vJetMax": 10
            }
        }
    ]
}